{
  "name": "reader-sideload-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "tauri": "tauri",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml && playwright test",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "build:app": "tsc --noEmit && vite build --config vite.app.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site && node scripts/assemble-dist.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-dialog": "2.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "22.17.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
